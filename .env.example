# =============================================================================
# Enterprise RAG - example environment configuration (.env.example)
# =============================================================================
# Copy to `.env` (`cp .env.example .env`) and fill in the values following the
# instructions in IMPLEMENTATION_PLAN.md §3. CI secrets are set in GitHub Actions Secrets (§4 item 5).
#
# NOTE: variable names = UPPER-case `Settings` fields (pydantic-settings, see
# core/modules_spec.md §1): the env mapping is strictly by field name. Any mismatch =
# the variable is not picked up. The values below are the defaults from `Settings` (the operator
# changes only what is needed). DO NOT ever commit a filled-in `.env` (it is in `.gitignore`).
# -----------------------------------------------------------------------------

# --- Deployment & Licensing (client side) ----------------------------------
# saas_cloud | on_premise_box (single codebase, the difference is only in the runtime config).
DEPLOYMENT_MODE=saas_cloud
# LICENSE_KEY - activation .key/code (Box); LICENSE_PUBLIC_KEY - the public Ed25519 key of the
# offline validator (embedded into the client).
LICENSE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_SERVER_URL=https://license.your-rag-domain.com

# --- Vendor Backoffice & License Server (vendor contour ONLY) ---------------
# On the Box client BACKOFFICE_ENABLED is always false; these fields are NOT included in the Box artifact.
BACKOFFICE_ENABLED=false
BACKOFFICE_HOST=127.0.0.1
BACKOFFICE_PORT=8090
BACKOFFICE_RATE_LIMIT_PER_MINUTE=60
BACKOFFICE_TOTP_REQUIRED=true
# The private Ed25519 license-signing key - only in the signing service / HSM / KMS.
LICENSE_SIGNING_SERVICE_URL=
LICENSE_CRL_URL=

# =============================================================================
# --- Supabase / Postgres (Stage B - storage layer) -------------------------
# =============================================================================
# DB CONNECTION: below are ALL the variables needed for migrations (Alembic),
# user-retrieval under RLS and working with the Supabase API. A step-by-step "where
# to get what" guide is at the end of the section (items 1-7). DO NOT commit a filled-in `.env`.
# -----------------------------------------------------------------------------
#
# [1] Supabase project identifier (ref) - a part like `abcdefgh12345678`
#     from the project URL `https://<ref>.supabase.co`. Needed to build the pooler DSN.
SUPABASE_PROJECT_REF=
# [2] Project base URL: Dashboard -> Project Settings -> API -> `Project URL`.
#     Form: https://<ref>.supabase.co
SUPABASE_URL=
# [3] anon public key: Project Settings -> API -> `Project API keys` -> `anon` `public`.
#     Safe for the frontend (works ONLY through RLS). NOT used for migrations.
SUPABASE_ANON_KEY=
# [4] service_role secret key: Project Settings -> API -> `service_role` `secret`.
#     BYPASSES RLS - backend/edge only, NEVER on the frontend and not in git.
SUPABASE_SERVICE_ROLE_KEY=
#
# --- PostgreSQL connection strings ------------------------------------------
# [5] POSTGRES_DSN - ADMIN connection (Alembic migrations/workers; role `postgres`,
#     BYPASSES RLS). NEVER for user-retrieval. The `psycopg` driver is mandatory
#     (psycopg3): scheme `postgresql+psycopg://...`, not bare `postgresql://`.
#     Where to get it: Dashboard -> Project Settings -> Database -> `Connection string`.
#       - For migrations use `Session` mode (port 5432) or a direct connection.
#       - Pooler (Supavisor) direct/session: host `aws-0-<region>.pooler.supabase.com`,
#         user like `postgres.<ref>`.
#     Direct connection template:
#       postgresql+psycopg://postgres:<DB_PASSWORD>@db.<ref>.supabase.co:5432/postgres
#     Session-pooler template:
#       postgresql+psycopg://postgres.<ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
POSTGRES_DSN=postgresql+psycopg://postgres:postgrespassword@localhost:5432/postgres
# [6] POSTGRES_APP_DSN - user-retrieval under the `app_user` role (NOBYPASSRLS, a member of
#     `authenticated`); without it the RLS policies tenant_isolation_* will return 0 rows
#     (default-deny, storage_schema.md §4). Same host/port as POSTGRES_DSN,
#     but user=`app_user` and the password from POSTGRES_APP_PASSWORD.
#       postgresql+psycopg://app_user:<APP_PASSWORD>@db.<ref>.supabase.co:5432/postgres
POSTGRES_APP_DSN=
# [7] Password of the `app_user` role (set OPERATIONALLY, NOT in a migration). After the first
#     `alembic upgrade head` (the role is created by migration 0001 without a password) run
#     in the SQL Editor / psql as admin:
#       ALTER ROLE app_user WITH PASSWORD '<APP_PASSWORD>';
#     Then put the same password into POSTGRES_APP_DSN (item 6).
POSTGRES_APP_PASSWORD=
#
# --- HOW TO BRING UP THE DB STEP BY STEP (Supabase) -------------------------
#  (1) Create a project at supabase.com -> copy the `ref` (item [1]).
#  (2) Project Settings -> API: copy the Project URL, anon, service_role
#      ([2]-[4]). Keep service_role secret.
#  (3) Project Settings -> Database -> `Reset database password` (or take the
#      existing one) -> this is <DB_PASSWORD> for POSTGRES_DSN ([5]).
#  (4) Assemble POSTGRES_DSN from the template in [5] (do not forget `+psycopg`).
#  (5) Apply the migrations with the admin role:
#        POSTGRES_DSN="postgresql+psycopg://..." alembic upgrade head
#      (migration 0001 creates the pgvector extensions, roles app_user/authenticated and the schema).
#  (6) Set the app_user password ([7]) and assemble POSTGRES_APP_DSN ([6]).
#  (7) Isolation check (optional): under POSTGRES_APP_DSN, queries to tenant tables
#      without the GUC `app.current_tenant_id` set must return 0 rows.
#  CI: these same secrets are set not in `.env`, but in GitHub Actions -> Secrets (§4 item 5).
# -----------------------------------------------------------------------------

# --- S3 Object Storage / R2 / MinIO (Stage D) ------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DEFAULT_BUCKET=enterprise-rag-documents
S3_REGION_NAME=auto

# --- LLM & Embedder (Stages D/F) -------------------------------------------
# Groq - primary; Gemini - fallback; Ollama - local fallback / Box.
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
# Active embedding version stamped on new chunks; bump + `reembed_corpus` = atomic re-embed switch.
EMBEDDING_VERSION=1

# --- Ingestion: Parent-Child splitter bounds + durable-queue resilience -----
# Token-aware splitter bounds (core/architecture.md §3) and the retry/backoff +
# File Watcher debounce policy (§4). The pipeline/splitter/watcher read these.
CHUNK_PARENT_MIN_TOKENS=800
CHUNK_PARENT_MAX_TOKENS=1200
CHUNK_CHILD_MIN_TOKENS=150
CHUNK_CHILD_MAX_TOKENS=250
CHUNK_CHILD_OVERLAP_TOKENS=30
INGEST_MAX_RETRIES=3
INGEST_RETRY_BASE_DELAY=1.0
INGEST_RETRY_MAX_DELAY=5.0
FILE_WATCHER_DEBOUNCE_SECONDS=2.5

# --- RAG Parameters (Stage E/F) --------------------------------------------
RETRIEVAL_TOP_CANDIDATES=30
RRF_K=60
RRF_ALPHA=0.6
RRF_BETA=0.4
CONFIDENCE_THRESHOLD=0.35
MAX_HISTORY_TURNS=5
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=1024
GENERATION_MAX_CONTEXT_TOKENS=4000

# --- Channels (Stage G) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Admin Panel & Session Auth (Stage I) ----------------------------------
# On Box ADMIN_HOST=127.0.0.1 (access only through an SSH tunnel).
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
ADMIN_STATIC_DIR=apps/admin/dist
# JWT_SECRET - session key (HS256, >= 32 bytes), SEPARATE from the licensing Ed25519 key.
JWT_SECRET=
SESSION_COOKIE_NAME=rag_admin_session
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CSRF_ENABLED=true
TOTP_REQUIRED_FOR_ADMIN=true
ADMIN_RATE_LIMIT_PER_MINUTE=120
WIDGET_RATE_LIMIT_PER_MINUTE=20

# --- Vector Store & Object Storage ports -----------------------------------
VECTOR_STORE_PROVIDER=pgvector
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_LOCAL_ROOT=./data

# --- Observability / Langfuse (Stage H) ------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
LANGFUSE_DISABLE_SIGNUP=true
TRACE_SAMPLE_RATE=1.0
TRACE_RETENTION_DAYS=30
# TRACE_MASK_FIELDS - JSON array of fields to mask (pydantic-settings parses it as a list).
TRACE_MASK_FIELDS=["password","api_key","token"]
# Telemetry - two DIFFERENT flags (§5), do not confuse:
# TELEMETRY_OPT_OUT: true = telemetry is disabled (default, 152-FZ/GDPR).
TELEMETRY_OPT_OUT=true
# OBSERVABILITY_FORWARD_ENABLED (CANONICAL name): opt-in forwarding of anonymized
# metrics/traces from Box to the vendor. The deprecated alias TELEMETRY_FORWARD_ENABLED is not allowed.
OBSERVABILITY_FORWARD_ENABLED=false

# --- Identity / end-user SSO (Stage C, gated by the sso_oidc feature) -------
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_JWKS_URL=
OIDC_GROUPS_CLAIM=groups
