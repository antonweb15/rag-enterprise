# =============================================================================
# Enterprise RAG — пример конфигурации окружения (.env.example)
# =============================================================================
# Скопируйте в `.env` (`cp .env.example .env`) и заполните значениями по инструкциям
# IMPLEMENTATION_PLAN.md §3. Секреты для CI задаются в GitHub Actions Secrets (§4 п.5).
#
# ⚠️ Имена переменных = ВЕРХНИЙ регистр полей `Settings` (pydantic-settings, см.
# core/modules_spec.md §1): маппинг env строго по имени поля. Любое расхождение =
# переменная не подхватится. Значения ниже — дефолты из `Settings` (оператор меняет
# только нужное). ⛔ НИКОГДА не коммитьте заполненный `.env` (он в `.gitignore`).
# -----------------------------------------------------------------------------

# --- Deployment & Licensing (клиентская часть) -----------------------------
# saas_cloud | on_premise_box (единый код, различие только в runtime-конфиге).
DEPLOYMENT_MODE=saas_cloud
# LICENSE_KEY — активационный .key/код (Box); LICENSE_PUBLIC_KEY — публичный Ed25519
# offline-валидатора (вшивается в клиент).
LICENSE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_SERVER_URL=https://license.your-rag-domain.com

# --- Vendor Backoffice & License Server (ТОЛЬКО контур вендора) -------------
# У клиента Box всегда BACKOFFICE_ENABLED=false; эти поля в артефакт Box НЕ входят.
BACKOFFICE_ENABLED=false
BACKOFFICE_HOST=127.0.0.1
BACKOFFICE_PORT=8090
BACKOFFICE_RATE_LIMIT_PER_MINUTE=60
BACKOFFICE_TOTP_REQUIRED=true
# Приватный Ed25519-ключ подписи лицензий — только в signing-сервисе / HSM / KMS.
LICENSE_SIGNING_SERVICE_URL=
LICENSE_CRL_URL=

# --- Supabase / Postgres (Этап B) ------------------------------------------
SUPABASE_URL=
# service_role secret key — только бэкенд/миграции, ОБХОДИТ RLS, не отдавать на фронт.
SUPABASE_SERVICE_ROLE_KEY=
# POSTGRES_DSN — админ-подключение (миграции Alembic/воркеры, роль postgres/service_role,
#   ОБХОДИТ RLS). ⛔ НИКОГДА не для user-retrieval. Драйвер (psycopg) появится на Этапе B.
POSTGRES_DSN=postgresql://postgres:postgrespassword@localhost:5432/postgres
# POSTGRES_APP_DSN — user-retrieval под ролью app_user (NOBYPASSRLS, член authenticated),
#   иначе tenant_isolation_* вернут 0 строк (default-deny, см. storage_schema.md §4).
POSTGRES_APP_DSN=

# --- S3 Object Storage / R2 / MinIO (Этап D) -------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DEFAULT_BUCKET=enterprise-rag-documents
S3_REGION_NAME=auto

# --- LLM & Embedder (Этапы D/F) --------------------------------------------
# Groq — основной; Gemini — fallback; Ollama — локальный fallback / Box.
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# --- RAG Parameters (Этап E/F) ---------------------------------------------
RETRIEVAL_TOP_CANDIDATES=30
RRF_K=60
RRF_ALPHA=0.6
RRF_BETA=0.4
CONFIDENCE_THRESHOLD=0.35
MAX_HISTORY_TURNS=5
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=1024

# --- Channels (Этап G) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Admin Panel & Session Auth (Этап I) -----------------------------------
# В Box ADMIN_HOST=127.0.0.1 (доступ только через SSH-туннель).
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
ADMIN_STATIC_DIR=apps/admin/dist
# JWT_SECRET — сессионный ключ (HS256, >= 32 байт), ОТДЕЛЬНЫЙ от лицензионного Ed25519.
JWT_SECRET=
SESSION_COOKIE_NAME=rag_admin_session
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CSRF_ENABLED=true
TOTP_REQUIRED_FOR_ADMIN=true
ADMIN_RATE_LIMIT_PER_MINUTE=120
WIDGET_RATE_LIMIT_PER_MINUTE=20

# --- Vector Store & Object Storage ports -----------------------------------
VECTOR_STORE_PROVIDER=pgvector
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_LOCAL_ROOT=./data

# --- Observability / Langfuse (Этап H) -------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
LANGFUSE_DISABLE_SIGNUP=true
TRACE_SAMPLE_RATE=1.0
TRACE_RETENTION_DAYS=30
# TRACE_MASK_FIELDS — JSON-массив маскируемых полей (pydantic-settings парсит как список).
TRACE_MASK_FIELDS=["password","api_key","token"]
# Телеметрия — два РАЗНЫХ флага (§5), не путать:
# TELEMETRY_OPT_OUT: true = телеметрия выключена (по умолчанию, 152-ФЗ/GDPR).
TELEMETRY_OPT_OUT=true
# OBSERVABILITY_FORWARD_ENABLED (КАНОНИЧЕСКОЕ имя): opt-in форвард обезличенных
# метрик/трейсов из Box вендору. ⛔ Устаревший alias TELEMETRY_FORWARD_ENABLED недопустим.
OBSERVABILITY_FORWARD_ENABLED=false

# --- Identity / SSO конечного пользователя (Этап C, гейт фичи sso_oidc) -----
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_JWKS_URL=
OIDC_GROUPS_CLAIM=groups
